NEXT_PUBLIC_API_URL=http://localhost:8000

# Hub multi-marché (France, MARCHE_FRANCE.md Phase F4) — URL racine de
# chaque marché, lue côté serveur uniquement (jamais NEXT_PUBLIC_, ce n'est
# pas affiché au client). Domaines pas encore réservés (🧑) : les valeurs
# par défaut (tawla.tn / tawla.fr) sont l'hypothèse de travail du document,
# à corriger ici une fois les noms définitifs confirmés — zéro changement de
# code.
TAWLA_TN_URL=https://tawla.tn
TAWLA_FR_URL=https://tawla.fr

# Coupe-circuit de la visite guidée (lib/visite/etat.ts). Désactivée par
# défaut : mettre "1" pour l'activer.
NEXT_PUBLIC_VISITE_GUIDEE=

# Analytics produit (PostHog) — funnel démo → abonnement (voir
# lib/analytics.ts). Laisser vide désactive tout tracking sans casser le
# reste de l'app. Project token (public, sans danger à exposer côté client) :
# PostHog > Project Settings > General, projet Tawla (EU Cloud).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
