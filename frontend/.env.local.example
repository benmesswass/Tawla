NEXT_PUBLIC_API_URL=http://localhost:8000

# Marché servi par CE déploiement (voir lib/market.ts et
# MARCHE_FRANCE.md §4) — un déploiement sert un seul marché, jamais une
# bascule par requête. "tn" par défaut : ne rien poser en Tunisie ne doit
# rien changer au comportement actuel.
NEXT_PUBLIC_MARKET=tn

# URLs des DEUX sites de marché, utilisées par le sélecteur de pays
# (app/choisir-pays, app/api/choisir-marche) et par le bandeau "vous semblez
# être ailleurs" — mêmes valeurs sur les trois déploiements (hub + les deux
# marchés). Domaines réels non tranchés (MARCHE_FRANCE.md Annexe C, C4) :
# laisser vide désactive silencieusement les liens vers l'autre marché.
NEXT_PUBLIC_TN_SITE_URL=
NEXT_PUBLIC_FR_SITE_URL=

# Coupe-circuit de la visite guidée (lib/visite/etat.ts). Désactivée par
# défaut : mettre "1" pour l'activer.
NEXT_PUBLIC_VISITE_GUIDEE=
