DATABASE_URL=postgresql://postgres:postgres@db:5432/resto_qr
ENV=development

# Signe les tokens d'auth staff — générer une vraie valeur en prod
# (ex: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Le démarrage refuse de se lancer si ENV=production ET que cette valeur
# est restée celle de dev ci-dessous (voir app/core/config.py).
JWT_SECRET=dev-only-secret-change-in-production

# Origine(s) autorisées en CORS pour le frontend, séparées par une
# virgule (ex: https://tawla.tn,https://www.tawla.tn). Laisser la valeur
# par défaut (port du frontend en dev local) tant qu'aucun domaine de prod
# n'est réservé.
FRONTEND_ORIGIN=http://localhost:3000

# Notifications push navigateur (client notifié quand sa commande est
# prête) — laisser vide désactive la fonctionnalité sans casser le reste
# de l'app (voir app/core/push.py). Générer une paire avec :
# python -c "
# from py_vapid import Vapid02
# from py_vapid.utils import b64urlencode
# from cryptography.hazmat.primitives import serialization
# v = Vapid02(); v.generate_keys()
# pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
# priv = v.private_key.private_numbers().private_value
# print('VAPID_PUBLIC_KEY=' + b64urlencode(pub))
# print('VAPID_PRIVATE_KEY=' + b64urlencode(priv.to_bytes(32, 'big')))
# "
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=contact@tawla.tn

# URLs canoniques — une seule valeur chacune (contrairement à FRONTEND_ORIGIN,
# qui peut lister plusieurs origines CORS). Utilisées pour construire les URLs
# de retour/webhook du paiement d'abonnement (app/core/konnect.py).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Paiement en ligne du passage à un palier supérieur (voir app/core/konnect.py).
# Laisser PAYMENT_MODE vide : le paiement reste en mode démonstration (palier
# appliqué immédiatement, aucun argent réel) — la seule présence des clés
# ci-dessous ne suffit jamais à activer un paiement réel. Passer à
# PAYMENT_MODE=konnect + poser les trois variables suivantes le jour où Tawla
# (l'entreprise, pas un restaurant pilote) a un compte marchand Konnect actif :
# KONNECT_API_KEY, KONNECT_RECEIVER_WALLET_ID (fournis par Konnect),
# KONNECT_WEBHOOK_SECRET (optionnel — dérivé de JWT_SECRET si absent).
PAYMENT_MODE=
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=
KONNECT_WEBHOOK_SECRET=
