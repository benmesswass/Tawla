DATABASE_URL=postgresql://postgres:postgres@db:5432/resto_qr
ENV=development

# Marché servi par cette instance (voir app/core/markets.py) — "tn" ou "fr".
# Un déploiement par marché (MARCHE_FRANCE.md §4) : jamais les deux dans le
# même processus. Laisser "tn" tant qu'aucun déploiement français n'existe.
MARKET=tn

# Signe les tokens d'auth staff — générer une vraie valeur en prod
# (ex: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Le démarrage refuse de se lancer si ENV=production ET que cette valeur
# est restée celle de dev ci-dessous (voir app/core/config.py).
JWT_SECRET=dev-only-secret-change-in-production

# Verrou de création d'un compte plateforme (dashboard admin cross-tenant,
# /admin côté frontend) — seul secret qui autorise POST
# /api/v1/platform-admin/admins (voir platform_admin/router.py::create_admin).
# À générer une fois, garder dans un gestionnaire de mots de passe, jamais
# committer. Même garde-fou qu'au-dessus : refuse de démarrer en prod avec
# la valeur de dev.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_CREATION_SECRET=dev-only-admin-secret-change-in-production

# Chiffrement au repos des clés Konnect propres à chaque restaurant (voir
# app/core/crypto.py) — optionnelle : dérivée de JWT_SECRET si absente, une
# clé dédiée n'est utile que pour la faire tourner indépendamment un jour.
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Origine(s) autorisées en CORS pour le frontend, séparées par une
# virgule (ex: https://tawla.tn,https://www.tawla.tn). Laisser la valeur
# par défaut (port du frontend en dev local) tant qu'aucun domaine de prod
# n'est réservé.
FRONTEND_ORIGIN=http://localhost:3000

# Notifications push navigateur (client notifié quand sa commande est
# prête) — laisser vide désactive la fonctionnalité sans casser le reste
# de l'app (voir app/core/push.py). Générer une paire avec :
# python -c "
# from py_vapid import Vapid02
# from py_vapid.utils import b64urlencode
# from cryptography.hazmat.primitives import serialization
# v = Vapid02(); v.generate_keys()
# pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
# priv = v.private_key.private_numbers().private_value
# print('VAPID_PUBLIC_KEY=' + b64urlencode(pub))
# print('VAPID_PRIVATE_KEY=' + b64urlencode(priv.to_bytes(32, 'big')))
# "
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=contact@tawla.tn

# URLs canoniques — une seule valeur chacune (contrairement à FRONTEND_ORIGIN,
# qui peut lister plusieurs origines CORS). Utilisées pour construire les URLs
# de retour/webhook du paiement d'abonnement (app/core/konnect.py).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Paiement en ligne du passage à un palier supérieur (voir app/core/konnect.py).
# Laisser PAYMENT_MODE vide : le paiement reste en mode démonstration (palier
# appliqué immédiatement, aucun argent réel) — la seule présence des clés
# ci-dessous ne suffit jamais à activer un paiement réel. Passer à
# PAYMENT_MODE=konnect + poser les trois variables suivantes le jour où Tawla
# (l'entreprise, pas un restaurant pilote) a un compte marchand Konnect actif :
# KONNECT_API_KEY, KONNECT_RECEIVER_WALLET_ID (fournis par Konnect),
# KONNECT_WEBHOOK_SECRET (optionnel — dérivé de JWT_SECRET si absent).
PAYMENT_MODE=
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_RECEIVER_WALLET_ID=
KONNECT_WEBHOOK_SECRET=

# Paiement carte du CLIENT (addition à table) — modèle direct, connecté
# individuellement par chaque restaurant depuis son dashboard (Réglages >
# Paiement carte de vos clients), jamais ici : ces identifiants-ci sont
# stockés chiffrés en base (voir app/core/crypto.py) — Konnect (Tunisie) —
# ou en clair, pas un secret (Restaurant.stripe_account_id, France), jamais
# en variable d'environnement.

# Stripe (marché France uniquement — app/core/stripe_gateway.py) : Connect
# pour le paiement carte du client (Direct Charges sur le compte de chaque
# restaurant), abonnement récurrent Tawla elle-même (mode Netflix), les deux
# derrière PAYMENT_MODE=stripe (variable partagée avec Konnect, posée
# au-dessus), même garde-fou anti-activation accidentelle. STRIPE_SECRET_KEY :
# clé secrète du compte Tawla (Développeurs > Clés API). STRIPE_WEBHOOK_SECRET
# et STRIPE_CONNECT_WEBHOOK_SECRET sont DEUX secrets DISTINCTS — Stripe en
# génère un par endpoint déclaré dans son tableau de bord, jamais le même
# pour deux URLs : le premier pour /api/v1/restaurants/stripe-subscription-webhook
# (renouvellements de l'abonnement Tawla), le second pour
# /api/v1/orders/stripe-card-webhook (paiement carte du client, Connect).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Confirmation de paiement + facture PDF par email (voir app/core/email.py).
# Dégradation gracieuse : sans RESEND_API_KEY, aucun envoi n'est tenté, même
# si le client a laissé son adresse. Compte Resend à créer sur resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Analytics produit (PostHog, serveur) — événement purchase_completed émis
# au règlement d'un abonnement (voir app/core/analytics.py et
# subscription_payments.py). Dégradation gracieuse : sans POSTHOG_API_KEY,
# aucun envoi n'est tenté. Project token dans PostHog > Project Settings >
# General (même projet EU que le frontend, host EU obligatoire ici — pas le
# défaut US du SDK).
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Lecture des mêmes données depuis le dashboard admin plateforme (voir
# app/core/posthog_query.py) — clé PERSONNELLE distincte de POSTHOG_API_KEY
# ci-dessus (lecture seule, scope insight:read + query:read uniquement sur
# le projet Tawla — PostHog > Settings > Personal API keys). Ne jamais
# envoyer au frontend. Dégradation gracieuse : sans elle, la section
# analytics du dashboard admin reste vide.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_APP_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=263083

# Étiquette `env` posée sur chaque événement émis par ce backend — SÉPARÉE
# de ENV ci-dessus (celle-là contrôle les garde-fous de sécurité JWT_SECRET/
# ADMIN_CREATION_SECRET). Laisser vide (= "development") en local. Sur
# tawla-backend-fr / tawla-backend.onrender.com : poser POSTHOG_ENV=staging
# (ce sont les URLs Vercel actuelles, pas encore le vrai domaine public — le
# dashboard admin, filtré sur env=production, doit rester vide jusque-là).
# Passer à POSTHOG_ENV=production seulement sur le backend qui sert le vrai
# domaine, le jour où il existe.
POSTHOG_ENV=
